# Copy to .env for local development. Every variable is validated at boot by
# src/config/env.ts; the process exits listing every problem it finds.

NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/csq?replicaSet=rs0
LOG_LEVEL=debug

# Keycloak supplies identity only (sub, email, name); the CSQ database authorises.
KEYCLOAK_ISSUER=https://auth.tinydata.in/realms/csq
KEYCLOAK_JWKS_URI=https://auth.tinydata.in/realms/csq/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=csq-api

# Optional: when all three are set the app provisions Keycloak users itself.
# KEYCLOAK_ADMIN_URL=https://auth.tinydata.in
# KEYCLOAK_ADMIN_CLIENT_ID=csq-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# Comma-separated browser origins allowed by CORS; the public web app's URL.
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# HS256 secret for participant / registration link sessions (at least 32 chars).
LINK_SESSION_SECRET=change-me-to-a-random-string-of-32-plus-characters

# Without SMTP_URL e-mails are written to the notifications log only.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=CSQ <no-reply@acfi.in>

DEMO_REVEAL_OTP=false
SCHEDULER_ENABLED=true
