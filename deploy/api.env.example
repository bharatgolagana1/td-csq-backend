# Environment of the `api` container. Copy to deploy/api.env (git-ignored,
# chmod 600) and fill the three secrets from SSM; see deploy/README.md.
# src/config/env.ts validates every variable at boot and exits listing every
# problem, so a wrong file fails fast and loudly.

# --- runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Inside the compose network Mongo is `mongo`. The replica set member is
# advertised as 127.0.0.1:27017 (see the healthcheck in docker-compose.yml),
# so connect directly instead of through replica-set discovery; transactions
# still work because the server is a replica-set primary.
MONGO_URI=mongodb://mongo:27017/csq?directConnection=true
# fatal | error | warn | info | debug | trace | silent (JSON lines to stdout)
LOG_LEVEL=info

# --- identity (Keycloak supplies who; the CSQ database decides what) ---------
KEYCLOAK_ISSUER=https://auth.tinydata.in/realms/csq
KEYCLOAK_JWKS_URI=https://auth.tinydata.in/realms/csq/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=csq-api
# Optional, all three or none: lets the API create Keycloak users itself with
# a confidential service-account client that has manage-users on the realm.
# KEYCLOAK_ADMIN_URL=https://auth.tinydata.in
# KEYCLOAK_ADMIN_CLIENT_ID=csq-admin
# SSM: /csq/dev/keycloak-admin-client-secret
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- web -----------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (scheme + host, no path).
CORS_ORIGINS=https://app.dev.csq.aero
# Where e-mails and onboarding links point.
PUBLIC_WEB_URL=https://app.dev.csq.aero

# --- secrets -------------------------------------------------------------------
# HS256 secret for participant / registration link sessions, 32+ characters.
# Rotating it invalidates every outstanding assessment and registration link.
# SSM: /csq/dev/link-session-secret
LINK_SESSION_SECRET=

# --- mail ----------------------------------------------------------------------
# smtp:// or smtps:// URL with credentials. Without it every e-mail is written
# to the `notifications` collection and the log only (fine for a demo box).
# SSM: /csq/dev/smtp-url
# SMTP_URL=
MAIL_FROM=CSQ <no-reply@acfi.in>

# --- behaviour -----------------------------------------------------------------
# true shows the assessment OTP in API responses so a demo works without
# e-mail. Never true where real customers are assessed.
DEMO_REVEAL_OTP=false
# The in-process minute tick (reminders, cycle transitions). Exactly one API
# container must run it; this stack runs one.
SCHEDULER_ENABLED=true
