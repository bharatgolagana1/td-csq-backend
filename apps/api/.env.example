# Copy to .env and fill in. Never commit a filled-in copy: .env is gitignored
# and every value below is read only through src/config/env.ts.

# development | test | production
NODE_ENV=development

# TCP port the API listens on
PORT=4000

# Replica set required: the sampling lock commits as a multi-document transaction
MONGO_URI=mongodb://127.0.0.1:27017/csq?replicaSet=rs0

# Keycloak realm issuer, exactly as it appears in the "iss" claim
KEYCLOAK_ISSUER=https://auth.example.invalid/realms/REALM_NAME

# JWKS endpoint for that realm. Keys are fetched and cached, never bundled
KEYCLOAK_JWKS_URI=https://auth.example.invalid/realms/REALM_NAME/protocol/openid-connect/certs

# The "aud" claim every accepted access token must carry
KEYCLOAK_AUDIENCE=csq-api

# Comma separated absolute origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,https://app.example.invalid

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
